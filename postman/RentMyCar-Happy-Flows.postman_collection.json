            "header": []
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "if (pm.response.code !== 200) {",
                  "  pm.execution.setNextRequest(null);",
                  "} else {",
                  "",
                  "pm.test('My list includes this confirmed reservation', () => {",
                  "  const rental = pm.response.json().find(rental => rental.id === Number(pm.collectionVariables.get('rentalId')));",
                  "  pm.expect(rental).to.be.an('object');",
                  "  pm.expect(rental.car.id).to.eql(Number(pm.collectionVariables.get('carId')));",
                  "  pm.expect(rental.status).to.eql('CONFIRMED');",
                  "  pm.expect(Number(rental.totalPrice)).to.eql(25);",
                  "});",
                  "}"
