    {
      "name": "04 Renter flow — see the confirmed booking",
      "item": [
        {
          "name": "Log in as renter and save renterToken",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/login",
            "description": "",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{renterEmail}}\",\n  \"password\": \"{{renterPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.unset('renterToken');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "if (pm.response.code !== 200) {",
                  "  pm.execution.setNextRequest(null);",
                  "} else {",
                  "const data = pm.response.json();",
                  "pm.test('RENTER role', () => pm.expect(data.role).to.eql('RENTER'));",
                  "pm.test('JWT returned', () => pm.expect(data.token).to.be.a('string').and.match(/^[^.]+\\.[^.]+\\.[^.]+$/));",
                  "if (data.role !== 'RENTER') {",
                  "  console.error('Owner setup is required: run setup-happy-flow.ps1 and import its environment before running.');",
                  "  pm.execution.setNextRequest(null);",
                  "} else {",
                  "  const payload = JSON.parse(require('buffer').Buffer.from(data.token.split('.')[1], 'base64').toString());",
                  "  pm.collectionVariables.set('renterToken', data.token);",
                  "  pm.collectionVariables.set('renterId', payload.userId);",
                  "}",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "View confirmed reservation as renter",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/rentals/{{rentalId}}",
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{renterToken}}",
                  "type": "string"
                }
              ]
            },
            "header": []
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "if (pm.response.code !== 200) {",
                  "  pm.execution.setNextRequest(null);",
                  "} else {",
                  "const data = pm.response.json();",
                  "pm.test('Correct reservation, car, renter and status', () => {",
                  "  pm.expect(data.id).to.eql(Number(pm.collectionVariables.get('rentalId')));",
                  "  pm.expect(data.car.id).to.eql(Number(pm.collectionVariables.get('carId')));",
                  "  pm.expect(data.renterId).to.eql(Number(pm.collectionVariables.get('renterId')));",
                  "  pm.expect(data.status).to.eql('CONFIRMED');",
                  "  pm.expect(Number(data.totalPrice)).to.eql(25);",
                  "});",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Find the confirmed booking in my rentals",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/rentals",
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{renterToken}}",
                  "type": "string"
                }
              ]
