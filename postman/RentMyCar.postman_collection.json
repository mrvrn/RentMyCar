{
  "info": {
    "name": "RentMyCar API tests",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run in order. Requires an existing available car. Creates persistent users and rentals. See the accompanying README."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "carId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "email",
      "value": "",
      "type": "string"
    },
    {
      "key": "password",
      "value": "PostmanTest123!",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "startAt",
      "value": "",
      "type": "string"
    },
    {
      "key": "endAt",
      "value": "",
      "type": "string"
    },
    {
      "key": "rentalId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 Register a new user",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/register",
        "auth": {
          "type": "noauth"
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Postman Test User\",\n  \"email\": \"{{email}}\",\n  \"phone\": \"+31612345678\",\n  \"address\": \"Teststraat 1, Amsterdam\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('email', 'postman.' + pm.variables.replaceIn('{{$guid}}') + '@example.com');",
              "pm.collectionVariables.unset('token');",
              "pm.collectionVariables.unset('rentalId');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 201', () => pm.response.to.have.status(201));",
              ""
            ]
          }
        }
      ]
    },
    {
      "name": "02 Login and save token",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/login",
        "auth": {
          "type": "noauth"
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.unset('token');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) {",
              "  const data = pm.response.json();",
              "  pm.test('JWT returned', () => pm.expect(data.token).to.be.a('string').and.match(/^[^.]+\\.[^.]+\\.[^.]+$/));",
              "  if (typeof data.token === 'string') pm.collectionVariables.set('token', data.token);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Check selected car",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/cars/{{carId}}",
        "auth": {
          "type": "noauth"
        },
        "header": []
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) {",
              "  const data = pm.response.json();",
              "  pm.test('Correct car', () => pm.expect(data.id).to.eql(Number(pm.variables.get('carId'))));",
              "  pm.test('Car is available', () => pm.expect(data.isAvailable).to.eql(true));",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Create rental",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/rentals/{{carId}}",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"carId\": {{carId}},\n  \"startAt\": \"{{startAt}}\",\n  \"endAt\": \"{{endAt}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const start = new Date(Date.now() + 7 * 86400000);",
              "start.setUTCMilliseconds(0);",
              "pm.collectionVariables.set('startAt', start.toISOString().slice(0, 19));",
              "pm.collectionVariables.set('endAt', new Date(start.getTime() + 7200000).toISOString().slice(0, 19));",
              "pm.collectionVariables.unset('rentalId');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 201', () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) {",
              "  const data = pm.response.json();",
              "  pm.test('Rental ID returned', () => pm.expect(data.id).to.be.a('number').and.above(0));",
              "  pm.test('Correct car and status', () => {",
              "    pm.expect(data.carId).to.eql(Number(pm.variables.get('carId')));",
              "    pm.expect(data.status).to.eql('PENDING');",
              "  });",
              "  pm.test('Requested period returned', () => {",
              "    pm.expect(Date.parse(data.startAt + 'Z')).to.eql(Date.parse(pm.variables.get('startAt') + 'Z'));",
              "    pm.expect(Date.parse(data.endAt + 'Z')).to.eql(Date.parse(pm.variables.get('endAt') + 'Z'));",
              "  });",
              "  pm.test('Total price returned', () => pm.expect(data.totalPrice).to.match(/^\\d+\\.\\d{2}$/));",
              "  pm.collectionVariables.set('rentalId', data.id);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "05 Reject overlapping rental",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/rentals/{{carId}}",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"carId\": {{carId}},\n  \"startAt\": \"{{startAt}}\",\n  \"endAt\": \"{{endAt}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 409', () => pm.response.to.have.status(409));",
              ""
            ]
          }
        }
      ]
    },
    {
      "name": "06 Reject rental without token",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/rentals/{{carId}}",
        "auth": {
          "type": "noauth"
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"carId\": {{carId}},\n  \"startAt\": \"{{startAt}}\",\n  \"endAt\": \"{{endAt}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 401', () => pm.response.to.have.status(401));",
              ""
            ]
          }
        }
      ]
    },
    {
      "name": "07 Reject reversed dates",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/rentals/{{carId}}",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"carId\": {{carId}},\n  \"startAt\": \"{{endAt}}\",\n  \"endAt\": \"{{startAt}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 400', () => pm.response.to.have.status(400));",
              ""
            ]
          }
        }
      ]
    },
    {
      "name": "08 Reject duplicate registration",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/register",
        "auth": {
          "type": "noauth"
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Postman Test User\",\n  \"email\": \"{{email}}\",\n  \"phone\": \"+31612345678\",\n  \"address\": \"Teststraat 1, Amsterdam\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 409', () => pm.response.to.have.status(409));",
              ""
            ]
          }
        }
      ]
    },
    {
      "name": "09 Reject invalid login",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/login",
        "auth": {
          "type": "noauth"
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"deliberately-wrong-password\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 401', () => pm.response.to.have.status(401));",
              ""
            ]
          }
        }
      ]
    },
    {
      "name": "10 Reject invalid registration",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/register",
        "auth": {
          "type": "noauth"
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Postman Test User\",\n  \"email\": \"invalid-email\",\n  \"phone\": \"+31612345678\",\n  \"address\": \"Teststraat 1, Amsterdam\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 400', () => pm.response.to.have.status(400));",
              ""
            ]
          }
        }
      ]
    }
  ]
}
