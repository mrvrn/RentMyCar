{
  "info": {
    "name": "RentMyCar API tests",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run in order. Requires an existing available car. Creates persistent users and rentals. See the accompanying README."
  },
